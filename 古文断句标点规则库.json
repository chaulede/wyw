{
  "meta": {
    "title": "古文断句与标点规则库",
    "source": {
      "book": "古文断句与标点",
      "authors": [
        "张仓礼",
        "陈光前"
      ],
      "publisher": "吉林文史出版社",
      "year": 1986
    },
    "version": "1.0",
    "scope": "仅收录原书明确列举的规则与词表；原书未述者不补。",
    "trust_model": {
      "deterministic": "可由程序按字面判定的形式标志，可直接作为断句条件。",
      "requires_semantics": "须靠词义、语法、史地或文献知识判断者，只作提示，不得自动改标点。",
      "rule": "凡标记 requires_semantics=true 的条目，程序只能输出候选或告警。"
    },
    "wiring": {
      "sentence_start.fa_yu[].word": "INITIAL_WORDS_1",
      "sentence_start.time_words[].word": "INITIAL_WORDS_2",
      "sentence_start.compound_function_words[].word": "INITIAL_WORDS_2",
      "sentence_end.particles[].char": "FINAL_PARTICLES",
      "sentence_end.particles[].punct_on_question": "QUESTION_PARTICLES",
      "fixed_structures[].regex": "FIXED_PATTERNS",
      "rhetoric.parallel.criteria": "isParallelPair",
      "joints.speech_verbs.verbs": "speechVerbs",
      "knowledge.tongjia": "CLASSICAL_PINYIN_OVERRIDES / GLOSS 之外的独立表"
    }
  },
  "principles": {
    "objective": "客观：不因立场给“贼”“盗”“寇”一类词加引号，也不因好恶改动原意。",
    "scientific": "科学：先把句子点出，再逐个确定该用哪一种符号；符号之间须彼此配合，不可孤立处置。",
    "uniform": "统一：同一名词、同一用法全书一致，专名号、书名号尤须统一。",
    "procedure": [
      "通读全文，判明文体与章法",
      "先断句：辨句首标志、句尾标志、句中关节与固定结构",
      "再定符号：句、逗、顿、分、冒、引、问、叹",
      "分配层次：多重复句第一层用分号，第二层以下用逗号",
      "按自查清单复核"
    ],
    "order_note": "断句在先，标点在后；句读定，符号自定。"
  },
  "sentence_start": {
    "principle": "某类词只能或主要出现于句首，见之即为句头；反之，乎、哉、邪一类语气词不会出现在句首。",
    "fa_yu": [
      {
        "word": "盖",
        "punct": "before",
        "example": "五人者，盖当蓼洲周公之被逮，激于义而死焉者也。",
        "note": "表推断性说明。"
      },
      {
        "word": "夫",
        "punct": "before",
        "note": "作发语词时不译；另有指代“那个”与名词“成年男子”两种用法，此时不断。",
        "exceptions": [
          "则梦见夫人据案其身：指代",
          "荷担者三夫：名词"
        ]
      },
      {
        "word": "且夫",
        "punct": "before",
        "note": "只用于句首，表进一步申说，比“夫”专一。"
      },
      {
        "word": "今夫",
        "punct": "before",
        "note": "“今”已虚化，只有上文涉及古今对比时才有“当今”义，不可硬译“今天”。"
      }
    ],
    "time_words": [
      {
        "word": "是时",
        "gloss": "这个时候"
      },
      {
        "word": "后",
        "gloss": "后来"
      },
      {
        "word": "昔者",
        "gloss": "从前某个时候",
        "variants": [
          "曩者"
        ]
      },
      {
        "word": "日者",
        "gloss": "此前不远的某个时候"
      },
      {
        "word": "既已",
        "gloss": "某件事已经完成",
        "note": "“已”为完结。"
      },
      {
        "word": "既而",
        "gloss": "紧接着、跟着又",
        "variants": [
          "已而"
        ]
      },
      {
        "word": "向者",
        "gloss": "笼统指过去",
        "variants": [
          "乡者"
        ]
      },
      {
        "word": "俄而",
        "gloss": "过了很短一段时间",
        "variants": [
          "俄顷"
        ]
      },
      {
        "word": "方今",
        "gloss": "如今、目前、现阶段"
      },
      {
        "word": "有顷",
        "gloss": "过了一会",
        "variants": [
          "顷之",
          "顷间"
        ]
      },
      {
        "word": "乃今",
        "gloss": "如今",
        "variants": [
          "今而后",
          "而今而后"
        ],
        "note": "“而今而后”指从此以后。"
      }
    ],
    "time_words_usage": {
      "rule": "词前断开；时间词连用时逐个单断。",
      "exception": "时间词之前若有主语，主语与时间词同属领句之词，不可把主语断出去。",
      "examples": [
        "余幼时即嗜学",
        "汝去年书云",
        "十七年正月……二月……八月……",
        "二十二年二月……四月……九月……十月……"
      ]
    },
    "compound_function_words": [
      {
        "word": "其唯",
        "gloss": "大概只有、恐怕只有",
        "punct": "before",
        "example": "其唯江上之丈人乎"
      },
      {
        "word": "岂唯",
        "gloss": "难道只是、哪里只是",
        "variants": [
          "岂特",
          "岂独",
          "岂徒"
        ],
        "punct": "before"
      },
      {
        "word": "岂足",
        "gloss": "哪里值得、难道值得",
        "punct": "before"
      },
      {
        "word": "然且",
        "gloss": "这样，还……／然而，还……",
        "variants": [
          "然犹",
          "然尚"
        ],
        "punct": "before",
        "note": "“然”可断可不断，“然且”等词组必须断开。"
      },
      {
        "word": "然则",
        "gloss": "既然如此，那么",
        "punct": "before",
        "example": "然则又何以兵为"
      },
      {
        "word": "故夫",
        "gloss": "所以（承上启下，推出结论）",
        "punct": "before"
      },
      {
        "word": "大抵",
        "gloss": "大约、大都",
        "variants": [
          "大抵",
          "大底",
          "大氐"
        ],
        "punct": "before"
      },
      {
        "word": "得无",
        "gloss": "莫非是、是不是",
        "variants": [
          "得毋"
        ],
        "punct": "before",
        "pair": "得无……乎"
      },
      {
        "word": "何为",
        "gloss": "为什么（介宾倒装）",
        "variants": [
          "何谓",
          "胡为",
          "曷为",
          "奚为"
        ],
        "punct": "before",
        "except": "主语未承前省略时，须连主语读，不可把主语断开。"
      },
      {
        "word": "何以",
        "gloss": "用什么、靠什么",
        "variants": [
          "曷以",
          "胡以",
          "奚以",
          "何用"
        ],
        "punct": "before",
        "except": "主语未省时连主语读。"
      },
      {
        "word": "何其",
        "gloss": "怎么这样（问原因或程度）",
        "variants": [
          "曷其",
          "奚其"
        ],
        "punct": "before",
        "note": "上句出现主语时，“何其”紧跟在主语之后。"
      },
      {
        "word": "何必",
        "gloss": "为什么一定要",
        "punct": "before"
      },
      {
        "word": "何不",
        "gloss": "为什么不",
        "punct": "before"
      },
      {
        "word": "何故",
        "gloss": "为什么",
        "punct": "before"
      },
      {
        "word": "何乃",
        "gloss": "怎么竟",
        "punct": "before"
      },
      {
        "word": "乃遂",
        "gloss": "于是就",
        "punct": "before"
      },
      {
        "word": "难以",
        "gloss": "很难……",
        "punct": "before"
      },
      {
        "word": "未必",
        "gloss": "并不必然、不一定",
        "punct": "before"
      },
      {
        "word": "未尝",
        "gloss": "不曾、没有",
        "punct": "before"
      },
      {
        "word": "无乃",
        "gloss": "岂不是、恐怕",
        "punct": "before",
        "pair": "无乃……乎"
      },
      {
        "word": "犹尚",
        "gloss": "尽管如此，还……",
        "punct": "before"
      },
      {
        "word": "岂可",
        "gloss": "怎么能、怎么可以",
        "punct": "before"
      }
    ],
    "compound_function_words_usage": [
      "领起的多是一个分句而非整句，断开后须向上寻求相配的句子。",
      "前面大多无主语，主语多承前省；也有带主语出现的，须留神。",
      "短句中常不断开，但读时仍有停顿，故仍为判句标志。"
    ],
    "humble_words": [
      "寡人",
      "孤",
      "不穀",
      "不佞",
      "臣",
      "仆",
      "愚",
      "窃",
      "下官",
      "妾",
      "贱妾"
    ],
    "polite_words": [
      "陛下",
      "殿下",
      "阁下",
      "足下",
      "先生",
      "夫子",
      "子",
      "公",
      "君",
      "卿"
    ],
    "humble_polite_usage": {
      "rule": "看支配它的动词在它之前还是之后：动词在后，它受支配，是主语，居句首；动词在前，它作宾语，居句尾。",
      "examples": [
        "秦王必喜而见臣：臣居句尾",
        "窃：只在句首；若在别处且作动词，即非谦词"
      ],
      "note": "谦敬词也可作宾语、定语、补语、状语，不可一见即在词前断开。"
    },
    "noun_pronoun": {
      "rule": "句首出现的人或物，多是主语；代词作句首最易辨认。",
      "method": "先求句中主要动词以定谓语，再分析谓语与各名词、代词的关系，定出主语。",
      "risk": "主语前常带官名、爵位、封号、谥号、郡望，把主名掩住。",
      "examples": [
        "吾尝终日而思矣，不如须臾之所学也",
        "此岂非人之所谓贤豪间者邪"
      ]
    },
    "same_noun_repetition": {
      "rule": "同一名词或名词性词组连用，后一个是领起句子之词，应在二者之间断开。",
      "example": "秦数败赵军，赵军固壁不战。",
      "example_note": "前一个“赵军”是上句宾语，后一个是下句主语。"
    }
  },
  "sentence_end": {
    "principle": "有一类词只用于或主要用于句尾，认识它们等于认识了句子的终点。",
    "particles": [
      {
        "char": "也",
        "punct": "。",
        "exceptions": [
          {
            "context": "后面接“者”“乎”“哉”",
            "punct": "none"
          },
          {
            "context": "后面接“则”",
            "punct": "，"
          },
          {
            "context": "前后两个“也”同现（也……也）",
            "punct": "，"
          },
          {
            "context": "用于句中表停顿",
            "punct": "，",
            "example": "古之圣人，其出人也远矣"
          }
        ],
        "note": "表判断、陈述或停顿。"
      },
      {
        "char": "矣",
        "punct": "。",
        "note": "表完成或变化，相当于“了”；极少用于句中。"
      },
      {
        "char": "焉",
        "punct": "。",
        "note": "兼词或句末语气词。"
      },
      {
        "char": "耳",
        "punct": "。",
        "note": "只作句尾，相当于“罢了”。"
      },
      {
        "char": "尔",
        "punct": "。",
        "note": "句末语气词；亦作代词、词尾。"
      },
      {
        "char": "乎",
        "punct": "？",
        "exceptions": [
          {
            "context": "作介词，等于“于”",
            "punct": "none",
            "example": "生乎吾前"
          }
        ],
        "note": "表疑问、反问或推测。"
      },
      {
        "char": "与",
        "punct": "？",
        "variants": [
          "欤"
        ],
        "note": "疑问语气词；亦作动词、介词。"
      },
      {
        "char": "邪",
        "punct": "？",
        "variants": [
          "耶"
        ]
      },
      {
        "char": "哉",
        "punct": "？",
        "exceptions": [
          {
            "context": "表感叹语气",
            "punct": "！"
          },
          {
            "context": "反问而语气强",
            "punct": "？"
          }
        ],
        "note": "表反问用问号，表感叹用叹号，须按语气定。"
      },
      {
        "char": "夫",
        "punct": "！",
        "note": "表感叹；作发语词或名词时不断。"
      },
      {
        "char": "兮",
        "punct": "，",
        "note": "多作偶句中上一句的句尾；也有在词组之间表拖音的，不能见“兮”即断。",
        "example": "君不行兮夷犹，蹇谁留兮中洲"
      }
    ],
    "compound_endings": [
      {
        "word": "何如",
        "punct": "。",
        "except": "居动词前（何如则仕）或名词前（季布何如人也）时非句尾。"
      },
      {
        "word": "奈何",
        "punct": "。",
        "except": "居动词前（奈何取之尽锱铢）时非句尾。"
      },
      {
        "word": "若何",
        "punct": "。"
      },
      {
        "word": "也夫",
        "punct": "！"
      },
      {
        "word": "也乎",
        "punct": "？"
      },
      {
        "word": "也耶",
        "punct": "？"
      },
      {
        "word": "也与",
        "punct": "？"
      },
      {
        "word": "也已",
        "punct": "。"
      },
      {
        "word": "也已哉",
        "punct": "！"
      },
      {
        "word": "也哉",
        "punct": "！"
      },
      {
        "word": "乎哉",
        "punct": "！"
      },
      {
        "word": "云尔",
        "punct": "。"
      },
      {
        "word": "云云",
        "punct": "。"
      }
    ],
    "content_words": [
      {
        "type": "宾语居尾",
        "requires_semantics": true,
        "rule": "由动宾关系判定，不可孤立认定；宾语后未必是完整句子。",
        "example": "平原君家不肯出租税，奢以法治之，杀平原君用事者九人。",
        "note": "到“杀九人”语意才足，前两处只是分句。"
      },
      {
        "type": "补语居尾",
        "requires_semantics": true,
        "rule": "谓语（有宾语的先找准宾语）之后加补语；补语多为介词结构或数量结构。",
        "examples": [
          "得敢死之士三千人",
          "藏于博徒，藏于卖浆家"
        ]
      },
      {
        "type": "谓语居尾",
        "requires_semantics": true,
        "rule": "多是不带宾语的不及物动词；或本可带宾语而省略、或宾语前置；谓语也可由名词、形容词、数词充当。",
        "examples": [
          "汉兵败散而还",
          "占小善者率以录，名一艺者无不庸"
        ]
      }
    ]
  },
  "independent_elements": {
    "principle": "相对独立于句子、句群之外的词语与词组，可单断。",
    "interjections": [
      "嗟乎",
      "呜呼",
      "噫嘻",
      "已",
      "嘻"
    ],
    "interjection_note": "表说话人即将说出的话的情感，一般独立断开；有时带呼唤对象（呜呼曼卿）。“呜呼”又作“於戏”“於乎”“乌呼”。",
    "summary_words": [
      {
        "word": "故曰",
        "function": "推出结论"
      },
      {
        "word": "由此观之",
        "function": "总括推论",
        "variants": [
          "由是观之"
        ]
      },
      {
        "word": "其所谓",
        "function": "归纳推断",
        "note": "此词不单断。"
      },
      {
        "word": "要之",
        "function": "综合分论、提出要点",
        "variants": [
          "总之"
        ]
      }
    ],
    "vocatives": {
      "rule": "祭文、书信中的呼唤语，语法上独立，应单断。",
      "examples": [
        "呜呼曼卿",
        "微之"
      ]
    }
  },
  "joints": {
    "ordinals": {
      "total_clause_markers": [
        "其要有三",
        "君子有三戒",
        "何谓三时"
      ],
      "enumerators": [
        "一曰",
        "二曰",
        "三曰",
        "四曰",
        "五曰"
      ],
      "sequence_words": [
        "其次",
        "次之",
        "上",
        "中",
        "下",
        "首",
        "末"
      ],
      "repeat_endings": [
        "其不可一也",
        "其不可二也",
        "其不可三也"
      ],
      "rule": "先抓总提句，再依序数逐层断开，末以重复的结句收束。",
      "example": "夫立策决胜之术，其要有三：一曰形，二曰势，三日情。形者，言其大体得失之数也；势者，言其临时之宜、进退之机也；情者，言其心志可否之实也。"
    },
    "interrogatives": [
      {
        "word": "何",
        "variants": [
          "曷",
          "盍"
        ],
        "gloss": "什么、为什么、怎么"
      },
      {
        "word": "胡",
        "gloss": "为什么",
        "exception": "又作名词，古代称北方、西方少数民族为“胡”。"
      },
      {
        "word": "奚",
        "gloss": "什么、为什么"
      },
      {
        "word": "安",
        "gloss": "哪里、怎么",
        "exception": "又作形容词（安步当车）、动词（苟安一隅）。"
      },
      {
        "word": "焉",
        "gloss": "哪里"
      },
      {
        "word": "谁",
        "gloss": "谁",
        "note": "可居句首、句中、句尾，须先辨它与前后词的关系。"
      },
      {
        "word": "孰",
        "gloss": "谁、哪一个",
        "exception": "与“熟”通（孰视之＝仔细看）。"
      }
    ],
    "speech_verbs": {
      "verbs": [
        "曰",
        "言",
        "说",
        "谓",
        "告",
        "以为"
      ],
      "rule": "“曰”直接领起所说的话，不带听话对象；其余动词多用于叙述句，常带听话对象作宾语。",
      "subject_pitfall": "须先定说话人：主语可承前省；一人之语而用两个“曰”者，不可把后一个“曰”误认作他人。",
      "example": "庄暴见孟子，曰：“暴见于王，王语暴以好乐，暴未有以对也。”曰：“好乐何如？”",
      "example_note": "后一个“曰”仍是庄暴的话，不是孟子的话。",
      "no_colon_cases": [
        {
          "case": "叫做",
          "example": "命篇曰《归去来兮》"
        },
        {
          "case": "谈到、提到",
          "example": "士大夫之族，曰师曰弟子云者"
        },
        {
          "case": "说成",
          "example": "少见黑曰黑，多见黑曰白"
        },
        {
          "case": "表判断",
          "example": "称之曰能"
        }
      ],
      "omitted_verb": "表言动词可省，须从上下文补出；省“曰”者仍用引号。"
    },
    "citation_markers": [
      "书曰",
      "诗曰",
      "传曰",
      "《书》曰",
      "《诗》曰"
    ],
    "citation_rule": "先把引文整体断出，再处理引文前后的叙述语。"
  },
  "fixed_structures": [
