  "rhetoric": {
    "figures": [
      {
        "name": "比喻",
        "detect_by": [
          "譬之",
          "譬之若",
          "譬如",
          "犹",
          "若",
          "如"
        ],
        "rule": "先断比喻句，再断所喻之理。",
        "example": "譬之若良医，病万变，药亦万变。"
      },
      {
        "name": "对比",
        "detect_by": [
          "则……则",
          "正反成对的分句"
        ],
        "rule": "先找两组的起止。",
        "example": "器用便利，则用力少而得作多；用不具，则田畴荒，谷不殖。"
      },
      {
        "name": "顶真",
        "detect_by": [
          "上句末二字＝下句首二字"
        ],
        "rule": "蝉联处即断处。",
        "example": "必侮上，侮上者，逆道也。"
      },
      {
        "name": "重复",
        "levels": [
          "词语",
          "词组与句子",
          "句式"
        ],
        "rule": "抓重复的字或词，可切出并列成分。",
        "example": "不斫／不剪／不造奇／不宝"
      },
      {
        "name": "对偶",
        "detect_by": [
          "字数相等（或差一二字）",
          "结构相同",
          "同一位置用相同的虚字"
        ],
        "example": "吾尝终日而思矣，不如须臾之所学也；吾尝跂而望矣，不如登高之博见也。"
      },
      {
        "name": "排比",
        "criteria": [
          "句式（结构方式）相同",
          "字数大体相等",
          "三句以上接连而下",
          "多用相同的虚字或重复的词语"
        ],
        "example": "无恻隐之心，非人也；无羞恶之心，非人也；无辞让之心，非人也；无是非之心，非人也。"
      }
    ],
    "parallel": {
      "hook": "isParallelPair",
      "window_lengths": [
        4,
        5,
        6
      ],
      "min_pairs": 1,
      "length_equal": true,
      "score_identical_char": 2,
      "score_same_function_char": 1.5,
      "score_antonym_pair": 1.5,
      "threshold": {
        "len4": 2,
        "len5": 2.5,
        "len6_default": 3
      },
      "rule": "排比尚须满足“三句以上”与“重复虚字”两条，仅两句同构者按对偶处理。"
    },
    "composition": [
      {
        "name": "开合有序",
        "marker": "前有总述，后有分述",
        "example": "《答司马谏议书》“名实已明，而天下之理得矣”总起，后分驳侵官、生事、征利、拒谏。"
      },
      {
        "name": "杂中见整",
        "marker": "材料纷繁，以同构结句收束",
        "example": "《采草药》“此地势高下之不同也”“此物性之不同也”“此地气之不同也”“此人力之不同也”。"
      },
      {
        "name": "纹丝不乱",
        "marker": "说明性文字按层次推进",
        "example": "《张衡传》候风地动仪：外观—内部结构—外部结构—工艺—遇震表现—报震方法—灵验—评价—例证—影响。"
      },
      {
        "name": "错落有致",
        "marker": "有总有分、有照应、有重复",
        "example": "《原毁》以“是不亦责于己者重以周乎”“是不亦待于人者轻以约乎”两结句呼应篇首。"
      }
    ],
    "genre": [
      {
        "name": "议论文",
        "cues": [
          "其故何哉",
          "故曰",
          "然则",
          "提出—论证—结论"
        ],
        "strategy": "先抓论点句，再抓关节语，分层断开。"
      },
      {
        "name": "说明文",
        "cues": [
          "说明中心",
          "说明顺序",
          "分类并列（用根者、用叶者……）"
        ],
        "strategy": "先找中心与层次，再具体断句。"
      },
      {
        "name": "记叙文",
        "cues": [
          "时间",
          "地点",
          "人物",
          "事件"
        ],
        "strategy": "人名、官名、地名最易相混，先辨何者为人、何者为地。"
      },
      {
        "name": "书信、序跋",
        "cues": [
          "某启",
          "顿首",
          "不任区区向往之至",
          "命篇曰"
        ],
        "strategy": "起首称谓语、结尾套语自成句段；谦敬词可借为断句之助。"
      },
      {
        "name": "祭文",
        "cues": [
          "维……",
          "尚飨",
          "呜呼"
        ],
        "strategy": "“维”发语无实义，继以时间、主祭者身份、被祭对象；“尚飨”收尾；正文多骈偶。"
      },
      {
        "name": "韵文",
        "cues": [
          "押韵",
          "字数定格",
          "词牌曲牌"
        ],
        "strategy": "押韵处用句号，兼顾内容与格律。"
      }
    ]
  },
  "punctuation": {
    "quote_rules": [
      {
        "id": "direct_quote",
        "rule": "“曰”后引原文，用冒号＋引号，引文末标点放在引号内。",
        "example": "子曰：“学而时习之，不亦说乎？”"
      },
      {
        "id": "lead_without_quote",
        "rule": "“曰”后直接领起下文而不引原文，只用冒号，不加引号。",
        "example": "赞曰：……／异史氏曰：……"
      },
      {
        "id": "partial_quote",
        "rule": "引文不完整，可不加冒号；不用冒号的引文，引号内末尾不用句号（含叹号、问号），标点放在引号外。"
      },
      {
        "id": "no_colon_cases",
        "rule": "表“叫做”“谈到”“说成”“判断”的“曰”，不加冒号引号。",
        "examples": [
          "命篇曰《归去来兮》",
          "曰师曰弟子云者",
          "少见黑曰黑",
          "称之曰能"
        ]
      },
      {
        "id": "omitted_say_verb",
        "rule": "承前省略“曰”仍用引号；一问一答省去第二个“曰”的，不可把答话断入问话。"
      },
      {
        "id": "self_answer",
        "rule": "自问自答虽用“曰”，实为作者代答，不必加引号。",
        "example": "为是其智弗若与？曰：非然也。"
      },
      {
        "id": "quote_uses",
        "rule": "引号四用：人物语言、引言、特殊强调的词语、特殊名称（年号、庙号、谥号、尊号）。"
      },
      {
        "id": "no_ideological_quote",
        "rule": "不得为表示立场而给“贼”“盗”“寇”一类词加引号。"
      }
    ],
